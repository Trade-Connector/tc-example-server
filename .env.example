# Trade Connector example server: configuration.
#
# Copy this file to .env and fill it in:   cp .env.example .env && chmod 600 .env
# .env is git-ignored. Never commit it, paste it into chat, or put keys anywhere else.

# The Partner API address. TC will tell you the URL if it differs from this one.
TC_BASE_URL=https://api.tradeconnector.com.au/functions/v1/partner-api

# ---- Sandbox (test) ------------------------------------------------------------------------
# A tc_test_ key, created in the TC web app: Settings → API & Webhooks → API keys.
# New keys get jobs:read and jobs:write only. To exercise everything, also tick
# jobs:cancel, attachments:write and reference:read when you create the key.
TC_TEST_API_KEY=
# The whsec_ signing secret of your SANDBOX webhook endpoint (shown once when you add it in
# Settings → API & Webhooks → Webhooks, with URL https://<your-tunnel>/webhooks/tc/sandbox).
TC_TEST_WEBHOOK_SECRET=

# ---- Production (live) ---------------------------------------------------------------------
# Leave these empty unless you deliberately want to test against production.
# Live jobs reach real installers, and cancelling a booked job can cost money.
TC_LIVE_API_KEY=
TC_LIVE_WEBHOOK_SECRET=
# Live mode exists only when TC_LIVE_API_KEY is set AND this is exactly true.
# Even then the server starts in sandbox; you switch to live in the console.
TC_ALLOW_LIVE=false

# ---- Optional ------------------------------------------------------------------------------
# Your tunnel's public https URL, so the console can show the full webhook URLs.
# PUBLIC_WEBHOOK_BASE_URL=https://example-name.trycloudflare.com

# The console listens on loopback only. Changing CONSOLE_HOST exposes a page that can act with
# your keys; the server warns loudly if you do. Never tunnel the console port.
# CONSOLE_HOST=127.0.0.1
# CONSOLE_PORT=3000

# The webhook listener: the only port you expose (through a tunnel).
# WEBHOOK_HOST=0.0.0.0
# WEBHOOK_PORT=3001

# Where received events, job snapshots and the coverage checklist are kept (git-ignored).
# DATA_DIR=data

# debug, info, warn or error
# LOG_LEVEL=info
