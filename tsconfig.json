{
  // Type-check only. Node runs the .ts files directly (built-in type stripping, Node >= 22.18),
  // so there is no build step and no emitted JavaScript.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    // What Node's type stripping needs: explicit .ts imports, type-only imports marked,
    // and no TypeScript-only runtime syntax (enums, namespaces, parameter properties).
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    // The console's pure browser modules (public/lib/*.js) are imported by the tests: allowed,
    // with their types read from JSDoc, but not type-checked (they are plain browser JavaScript).
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
